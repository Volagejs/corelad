<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Corelad.Dock.Tests — sorun raporu panelinin sunum katmanı testleri.
    Hedef net48: test edilen Corelad.Dock ile aynı çalışma zamanı.
    CorelDRAW AÇILMAZ; COM nesnesi oluşturulmaz. Yalnızca ViewModel/DTO/metin test edilir.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Corelad.Dock\Corelad.Dock.csproj" />
    <ProjectReference Include="..\..\src\Corelad.Geometry\Corelad.Geometry.csproj" />
  </ItemGroup>

</Project>
