<UserControl x:Class="Corelad.Dock.Views.ProblemReportPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="420"
             d:DesignHeight="560"
             x:Name="Root"
             Background="#FFFFFF"
             FontFamily="Segoe UI"
             FontSize="12"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True"
             AutomationProperties.Name="Sorun raporu paneli"
             AutomationProperties.HelpText="Smart Divide analizindeki hata ve uyarıları listeler; seçilen sorunun konturu için vurgu isteği üretir.">

    <UserControl.Resources>

        <!-- Önem rozetleri: renk + sözcük birlikte kullanılır, renk tek başına anlam taşımaz. -->
        <Style x:Key="StatBorder" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ErrorBadge" TargetType="Border" BasedOn="{StaticResource StatBorder}">
            <Setter Property="Background" Value="#FDECEA" />
            <Setter Property="BorderBrush" Value="#B3261E" />
        </Style>

        <Style x:Key="WarningBadge" TargetType="Border" BasedOn="{StaticResource StatBorder}">
            <Setter Property="Background" Value="#FFF4E5" />
            <Setter Property="BorderBrush" Value="#B26A00" />
        </Style>

        <Style x:Key="InfoBadge" TargetType="Border" BasedOn="{StaticResource StatBorder}">
            <Setter Property="Background" Value="#EAF2FA" />
            <Setter Property="BorderBrush" Value="#1F4E79" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasInfo}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Odak halkası: düzen kaydırmadan görünür klavye odağı. -->
        <Style x:Key="ProblemItemFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2"
                                   Stroke="#1F4E79"
                                   StrokeThickness="2"
                                   SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProblemItemContainer" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ProblemItemFocusVisual}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding AccessibleHelpText}" />
            <Setter Property="ToolTip" Value="{Binding Description}" />
            <Setter Property="ToolTipService.ShowDuration" Value="20000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="#FFFFFF"
                                BorderBrush="#D0D0D0"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F5F5F5" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EAF2FA" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#1F4E79" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ProblemItemTemplate">
            <Grid Margin="12,10,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="SeverityBar"
                        Width="4"
                        Margin="0,0,10,0"
                        CornerRadius="2"
                        Background="#8A8A8A" />

                <StackPanel Grid.Column="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SeverityGlyph"
                                   Grid.Column="0"
                                   Text="{Binding SeverityGlyph}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#4A4A4A"
                                   Margin="0,0,6,0" />
                        <TextBlock x:Name="SeverityLabel"
                                   Grid.Column="1"
                                   Text="{Binding SeverityLabel}"
                                   FontWeight="SemiBold"
                                   Foreground="#4A4A4A"
                                   Margin="0,0,8,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding CodeText}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#5F5F5F"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <TextBlock Text="{Binding Title}"
                               FontWeight="SemiBold"
                               Foreground="#1F1F1F"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />

                    <TextBlock x:Name="LocationLine"
                               Text="{Binding LocationText}"
                               FontSize="11"
                               Foreground="#4A4A4A"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />

                    <TextBlock Text="{Binding DetailText}"
                               FontSize="11"
                               Foreground="#5F5F5F"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="SeverityBar" Property="Background" Value="#B3261E" />
                    <Setter TargetName="SeverityGlyph" Property="Foreground" Value="#B3261E" />
                    <Setter TargetName="SeverityLabel" Property="Foreground" Value="#B3261E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter TargetName="SeverityBar" Property="Background" Value="#B26A00" />
                    <Setter TargetName="SeverityGlyph" Property="Foreground" Value="#8A5300" />
                    <Setter TargetName="SeverityLabel" Property="Foreground" Value="#8A5300" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInfo}" Value="True">
                    <Setter TargetName="SeverityBar" Property="Background" Value="#1F4E79" />
                    <Setter TargetName="SeverityGlyph" Property="Foreground" Value="#1F4E79" />
                    <Setter TargetName="SeverityLabel" Property="Foreground" Value="#1F4E79" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LocationText}" Value="">
                    <Setter TargetName="LocationLine" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F3F3F3" />
            <Setter Property="BorderBrush" Value="#8A8A8A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E8E8E8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DCDCDC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="16" DataContext="{Binding ViewModel, ElementName=Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Sorun Raporu"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#1F1F1F" />
            <TextBlock Text="{Binding SummaryText}"
                       FontSize="11"
                       Foreground="#4A4A4A"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="{Binding SummaryAccessibleText}" />
        </StackPanel>

        <!-- Hata / uyarı / bilgi sayıları -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <Border Style="{StaticResource ErrorBadge}" AutomationProperties.Name="{Binding ErrorStatText}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="×"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#B3261E"
                               Margin="0,0,6,0" />
                    <TextBlock Style="{StaticResource StatValue}"
                               Foreground="#B3261E"
                               Text="{Binding ErrorStatText}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource WarningBadge}" AutomationProperties.Name="{Binding WarningStatText}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="!"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#8A5300"
                               Margin="0,0,6,0" />
                    <TextBlock Style="{StaticResource StatValue}"
                               Foreground="#8A5300"
                               Text="{Binding WarningStatText}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource InfoBadge}" AutomationProperties.Name="{Binding InfoStatText}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="i"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#1F4E79"
                               Margin="0,0,6,0" />
                    <TextBlock Style="{StaticResource StatValue}"
                               Foreground="#1F4E79"
                               Text="{Binding InfoStatText}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Sorun listesi -->
        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Background="#FFFFFF"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="4">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasProblems}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding ListHeading}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#4A4A4A"
                           Margin="12,8,12,4" />

                <ListBox Grid.Row="1"
                         x:Name="ProblemList"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource ProblemItemContainer}"
                         ItemTemplate="{StaticResource ProblemItemTemplate}"
                         SelectionMode="Single"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="6,0,6,6"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         KeyboardNavigation.TabNavigation="Once"
                         KeyboardNavigation.DirectionalNavigation="Contained"
                         TextSearch.TextPath="Title"
                         AutomationProperties.Name="Sorun listesi"
                         AutomationProperties.HelpText="Ok tuşlarıyla gezinin. Enter, seçili sorunun kontur vurgu isteğini yeniden gönderir."
                         PreviewKeyDown="OnProblemListPreviewKeyDown"
                         MouseDoubleClick="OnProblemListMouseDoubleClick" />
            </Grid>
        </Border>

        <!-- Boş / hazır durumu -->
        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Background="#F7F9F7"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="4">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasProblems}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MaxWidth="320"
                        Margin="16">
                <TextBlock Text="{Binding EmptyStateGlyph}"
                           FontSize="28"
                           Foreground="#1E6B33"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EmptyStateTitle}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#1F1F1F"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
                <TextBlock Text="{Binding EmptyStateMessage}"
                           FontSize="12"
                           Foreground="#4A4A4A"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
                <TextBlock Text="{Binding EmptyStateFootnote}"
                           FontSize="11"
                           Foreground="#5F5F5F"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <!-- Alt ipucu ve vurgu eylemi -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasProblems}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding HighlightHint}"
                       FontSize="11"
                       Foreground="#4A4A4A"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />

            <Button Grid.Column="1"
                    Content="Konturu vurgula"
                    Style="{StaticResource SecondaryButton}"
                    Margin="12,0,0,0"
                    IsEnabled="{Binding CanHighlightSelected}"
                    Click="OnHighlightClick"
                    AutomationProperties.Name="Seçili sorunun konturunu vurgula"
                    AutomationProperties.HelpText="Seçili sorunun kontur vurgu isteğini yeniden gönderir." />
        </Grid>
    </Grid>
</UserControl>
